<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HazardReporting" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Shown until MainActivity knows the start screen; then switches to Theme.HazardReporting -->
    <style name="Theme.HazardReporting.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HazardReporting</item>
    </style>
</resources>
